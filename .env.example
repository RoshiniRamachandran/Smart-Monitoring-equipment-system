# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database Configuration (MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mining_monitoring?retryWrites=true&w=majority

# Authentication Secret (JWT)
JWT_SECRET=your_jwt_secret_key_here

# Server Port (Defaults to 3000 in AI Studio, 5000 for standalone backend)
PORT=3000

# Client URL (for CORS when running client and server independently in VS Code)
CLIENT_URL=http://localhost:5173
